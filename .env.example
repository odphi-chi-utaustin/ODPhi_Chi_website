# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Bypasses RLS. Never expose to the client or commit.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe > Developers > API keys (server only)
STRIPE_SECRET_KEY=sk_test_...
# Stripe > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend > API Keys (server only). Emails are skipped when unset.
RESEND_API_KEY=re_...
# Any long random string; Vercel sends it as a Bearer token to /api/cron/*
CRON_SECRET=
